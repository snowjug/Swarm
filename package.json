{
  "name": "swarm-lab",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "A local-first, source-grounded multi-agent scenario simulation workbench.",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n api,web \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "tsx watch --env-file-if-exists=.env backend/src/index.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc -p backend/tsconfig.json",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "start": "node --env-file-if-exists=.env dist/backend/src/index.js",
    "typecheck": "tsc -p backend/tsconfig.test.json --noEmit && tsc -p frontend/tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit && tsc -p evaluation/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "smoke:console": "tsx backend/test/console-smoke.ts",
    "test:e2e": "playwright test",
    "audit:ui": "node scripts/ui-audit.mjs",
    "db:copy": "tsx scripts/db/copy.ts",
    "test:postgres": "node scripts/test-postgres.mjs",
    "mutation:security": "tsx scripts/mutation/run.ts",
    "eval": "tsx evaluation/src/run.ts",
    "demo:record": "tsx scripts/demo/record.ts",
    "demo:seed": "tsx --env-file-if-exists=.env scripts/demo/seed.ts",
    "demo:journey": "playwright test --config playwright.journey.config.ts",
    "azure:provision": "tsx scripts/azure/provision.ts",
    "azure:teardown": "tsx scripts/azure/teardown.ts",
    "azure:verify": "tsx scripts/azure/verify.ts",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@azure/identity": "4.13.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.6",
    "d3-force": "^3.0.0",
    "fastify": "^5.12.7",
    "jose": "^6.2.13",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "ajv@^8.0.0": "^8.20.0",
    "@azure/msal-node": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.11",
    "@electric-sql/pglite-socket": "^0.2.14",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "axe-core": "^4.14.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.6",
    "vitest": "^4.0.2"
  }
}
