# No credentials or cloud services are needed for the default local engine.

# What this process is (docs/CONFIGURATION.md, docs/production/identity.md). local: one person on their own machine,
# and nothing is refused. pilot or production: a hosted deployment, which starts only if it is set up to be hosted
# (Microsoft Entra sign-in, TLS to the database, https origins, telemetry and more), and says every reason it refuses
# in one error. Leave this as local, or remove the line: an empty value, or any word but these three, stops the start.
DEPLOYMENT_MODE=local
# What the product says it is: plain text, up to 80 characters. Empty is "LOCAL" for local and "PRODUCTION-CANDIDATE
# CONTROLLED PILOT" for a pilot. A pilot's label must say pilot and not production; a production one must be given.
DEPLOYMENT_LABEL=
# The commit this build was made from (7 to 40 hexadecimal characters), reported by GET /api/config. Empty: unknown.
BUILD_SHA=
# A pilot refuses a model API key unless this decision is recorded with the word true; production refuses one always.
# ALLOW_MODEL_API_KEY=true

HOST=127.0.0.1
PORT=3001
# Keep this OUTSIDE OneDrive/Dropbox/Google Drive/iCloud folders (the server warns if it is inside one).
# Windows example: DATA_DIR=C:\Users\<you>\AppData\Local\SwarmLab
DATA_DIR=./data
# Optional: a PostgreSQL database instead of the SQLite file in DATA_DIR, for anything that more than one
# instance shares. postgres://user@host:5432/database (the password goes in PGPASSWORD, not here).
DATABASE_URL=
# password (the default), or entra: the password is a Microsoft Entra access token, fetched for each
# connection (a managed identity when hosted). Leave the password out of DATABASE_URL when it is entra.
DATABASE_AUTH=password
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
LOG_LEVEL=info
# Multiplies every per-IP request limit (default 1 = production limits). Raise it only for
# automated browser tests or load tests of your own machine.
RATE_LIMIT_SCALE=1
# How many reverse proxies in front of this server to trust for the caller's address (X-Forwarded-For).
# 0 trusts none. Behind one ingress (a container platform) set 1. Never set it if the port is reachable directly.
TRUST_PROXY=0
# What this process does with the job queue: all (the default: serves requests and runs jobs), api (serves
# requests and only queues jobs) or worker (runs jobs from the queue and answers health probes). Any number
# of each may share one PostgreSQL database; the SQLite file is for one process.
SWARM_ROLE=all
# How long a worker may go without a heartbeat before its job is handed to another worker (10-600).
JOB_LEASE_SECONDS=30
# What each project may spend on the model in all, unless a workspace owner or administrator gives it a limit
# of its own: model calls, and tokens (input and output together). 0 is no limit. Once a project has used its
# limit the next model call is refused before anything is sent to the provider.
PROJECT_MODEL_CALL_LIMIT=0
PROJECT_MODEL_TOKEN_LIMIT=0
# Reading a public web page as evidence, when a person pastes its address (docs/security/url-ingestion.md).
# on (the default) or off. The page is fetched by this server, never by the browser, and only from public
# addresses: private, local and cloud-metadata addresses are refused however the address is written.
URL_INGESTION=on
# The ports a page may be read from, the most one page may be (bytes, before and after decompression), how long
# the whole fetch may take (milliseconds), and, optionally, the only hosts that may be read: `example.com`
# exactly or `*.example.com` for its subdomains (empty: any public host).
URL_INGEST_ALLOWED_PORTS=80,443
URL_INGEST_MAX_BYTES=1500000
URL_INGEST_TIMEOUT_MS=12000
URL_INGEST_ALLOWED_HOSTS=
# How many pages this server reads at the same moment for every caller together, how many requests may wait
# for one of those places, and for how long (milliseconds). A request beyond that is refused with a 503 that
# says to try again in a moment.
URL_INGEST_CONCURRENCY=8
URL_INGEST_QUEUE=8
URL_INGEST_QUEUE_WAIT_MS=5000
# Automatic research (backend/src/research/README.md): the first phase of grounding a project reads the page or
# site a person names, and what it links to, as evidence. on (the default) or off. It also needs URL_INGESTION=on,
# and it reads https only: there is no setting that reads plain http or a private address.
RESEARCH_ENABLED=on
# Finding sources from a question alone needs a search provider, which is the operator's choice: it is sent the
# names and topics of a question (never the question as typed) and answers with addresses, which are vetted like
# any other. none (the default): no search, and a run that was given only a question says so and waits for a
# source (docs/production/LIMITATIONS.md, A6). wikipedia: needs no key; finds background pages of Wikipedia, in
# English. brave: the Brave Search API; needs RESEARCH_SEARCH_API_KEY.
RESEARCH_SEARCH_PROVIDER=none
# The key of a provider that needs one (8 to 512 characters). It is read from here and never logged or returned.
# In a hosted deployment it is a Key Vault secret, never a value in a template.
RESEARCH_SEARCH_API_KEY=
# Where the provider is reached when it is not at its own address: for a test double on this machine only. A pilot
# or production start refuses it, so that a key is never sent anywhere else.
RESEARCH_SEARCH_ENDPOINT=
# How long one search may take, in milliseconds (1000 to 30000; empty is 8000).
RESEARCH_SEARCH_TIMEOUT_MS=
# What one run may use, at the most. These can only lower the ceilings (30 pages, 8 sites, 2 links from a starting
# page, 2 MB a page, 20 MB, 300 seconds and 2 US dollars of estimated model cost); empty keeps the ceiling. A
# person may ask for less than these, never for more.
RESEARCH_MAX_PAGES=
RESEARCH_MAX_DOMAINS=
RESEARCH_MAX_DEPTH=
RESEARCH_MAX_BYTES_PER_PAGE=
RESEARCH_MAX_TOTAL_BYTES=
RESEARCH_MAX_SECONDS=
RESEARCH_MAX_COST_USD=
# The least wait between two requests to one site (milliseconds; 250-10000): a person may ask for longer, never
# for shorter. And how long a run may stay paused (seconds; 30-420) before it ends with what it has read.
RESEARCH_DOMAIN_DELAY_MS=1000
RESEARCH_MAX_PAUSE_SECONDS=300
# Optional: export OpenTelemetry traces and metrics to Application Insights, signed with Microsoft Entra
# (AZURE_CLIENT_ID below names a user-assigned managed identity). Empty: nothing is exported.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# none | ollama | openai | azure | foundry
# Model-assisted runs must also be explicitly selected in the UI.
AI_PROVIDER=none
AI_MODEL=
AI_TIMEOUT_MS=120000

# Ollama: install separately, run `ollama pull qwen3:8b`, then set
# AI_PROVIDER=ollama and AI_MODEL=qwen3:8b. Requires sufficient local RAM.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# When using the app's Docker container with Ollama installed on the host:
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434

# OpenAI or another administrator-trusted OpenAI-compatible v1 endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Azure OpenAI / Microsoft Foundry (OpenAI v1 API). AI_MODEL is your DEPLOYMENT name.
# Either a resource root or its /openai/v1 endpoint is accepted. The host must end in
# .openai.azure.com, .cognitiveservices.azure.com or .services.ai.azure.com.
AZURE_OPENAI_ENDPOINT=
# entra (default): Microsoft Entra ID. No API key exists or is read. Locally run `az login`;
#   in Azure use a managed identity. Needs the "Cognitive Services OpenAI User" role on the resource.
# key: legacy API-key authentication, only for a resource that still allows keys.
AZURE_OPENAI_AUTH=entra
# Client id of a USER-ASSIGNED managed identity. Leave it out (not empty) for az login or a system-assigned identity.
# AZURE_CLIENT_ID=
# Read only when AZURE_OPENAI_AUTH=key.
AZURE_OPENAI_API_KEY=

# Microsoft Foundry through the OpenAI-compatible v1 API (AI_PROVIDER=foundry; docs/models/foundry.md). AI_MODEL is the
# name of your default DEPLOYMENT, and it is required. The settings below are read only when AI_PROVIDER=foundry, and
# they are commented out so that a copy of this file leaves them unset. Everything about it has been proved against an
# in-process fake of the endpoint, and nothing against a live resource.
# Choosing a deployment by role, failing over, pinning a data zone, holding an operation to an allowance and the cache
# are done by the task runner (backend/src/models/runner.ts). Today only the planning of a research run goes through it:
# every other model step is sent to the default deployment, AI_MODEL.
# https://<resource>.openai.azure.com or its /openai/v1 path; the host must end in .openai.azure.com,
# .services.ai.azure.com or .cognitiveservices.azure.com.
# FOUNDRY_ENDPOINT=
# entra (default): Microsoft Entra ID, no key (AZURE_CLIENT_ID above names a user-assigned managed identity).
# key: FOUNDRY_API_KEY is sent as a header; DEPLOYMENT_MODE=production refuses it, and a pilot needs ALLOW_MODEL_API_KEY.
# FOUNDRY_AUTH=entra
# FOUNDRY_API_KEY=
# A deployment of its own for a role: each defaults to AI_MODEL, and a deployment name is never a model name.
# FOUNDRY_DEPLOYMENT_RESEARCH_PLANNER=
# FOUNDRY_DEPLOYMENT_EXTRACTION=
# FOUNDRY_DEPLOYMENT_ACTOR=
# FOUNDRY_DEPLOYMENT_SCENARIO=
# FOUNDRY_DEPLOYMENT_CRITIC=
# FOUNDRY_DEPLOYMENT_SYNTHESIS=
# Preferred for a task that needs reasoning, and tried once when a task's own deployment is missing, throttled or down.
# FOUNDRY_DEPLOYMENT_REASONING=
# FOUNDRY_DEPLOYMENT_FALLBACK=
# When set, every task is served only from a deployment whose profile declares this data zone.
# FOUNDRY_DATA_ZONE=
# JSON, by deployment name: {"<deployment>": {"reasoning": true, "dataZone": "...", "maxContextChars": 100000,
# "latency": "fast", "structuredOutputs": true}}. What the operator says of a deployment; nothing is read from the network.
# FOUNDRY_DEPLOYMENT_PROFILES=

# Model use, for any provider that is not none (docs/models/foundry.md). Swarm ships no price: a cost is an estimate
# from the prices entered here, and a dollar limit refuses to start without them. MODEL_PRICES is a JSON array of
# {"deployment": "<name or pattern with *>", "inputPerMillionUsd": <number>, "outputPerMillionUsd": <number>}.
# MODEL_PRICES=
# What one operation that goes through the task runner may use: tokens, input and output together, and estimated
# dollars. 0 is no limit.
MODEL_OPERATION_TOKEN_LIMIT=0
MODEL_OPERATION_COST_LIMIT_USD=0
# off (the default) or tenant: the task runner keeps validated answers in this process's memory, never shared between
# tenants.
MODEL_CACHE=off
MODEL_CACHE_MAX_ENTRIES=256
MODEL_CACHE_TTL_SECONDS=900
# off (the default) or redacted: with redacted a trace may carry the size of a prompt and of a reply and a short hash
# of the prompt, never their text.
TELEMETRY_TRACE_CONTENT=off

# Publish the exact corresponding source before offering a remote service.
SOURCE_URL=

# Sign-in. none (default): one local user, no sign-in; bind to 127.0.0.1 only. entra: every API
# call needs a Microsoft Entra v2.0 access token, or a session started by signing in through this
# server. What a person may see and do comes from workspace and project membership, not from the
# token. The app roles Swarm.User (or the first release's Swarm.Reader, Swarm.Analyst,
# Swarm.Reviewer) let a person in; Swarm.Admin lets the first such person claim an empty workspace;
# Swarm.PlatformAdmin runs the platform and sees no project.
# The settings below that are commented out are the ones the server refuses when they are present and empty: leave
# them out until you give them a value.
AUTH_MODE=none
# Required when AUTH_MODE=entra. Tokens from any other tenant are refused.
# AUTH_ENTRA_TENANT_ID=
# Optional comma-separated GUIDs of further tenants to accept (a multi-tenant deployment).
AUTH_ENTRA_ALLOWED_TENANTS=
# Required when AUTH_MODE=entra: the application ID URI or client ID that tokens are issued for.
# AUTH_ENTRA_AUDIENCE=
# Optional HTTPS override of the signing-key endpoint. Defaults to Microsoft's published keys.
AUTH_ENTRA_JWKS_URI=
# Browser sign-in (Authorization Code with PKCE, a server-side session, no token in the browser).
# Set both or neither. The client ID is the app registration people sign in to; the redirect URI is
# https (http only on localhost), ends in /auth/callback, and its host must be in ALLOWED_HOSTS.
# AUTH_ENTRA_CLIENT_ID=
AUTH_ENTRA_REDIRECT_URI=
# Optional, for a confidential client. Never put a value here in source: use a secret store.
# AUTH_ENTRA_CLIENT_SECRET=
# Or, instead of a secret: managed-identity (the application proves itself with a token from its managed
# identity; needs a federated credential on the app registration). Not together with a secret.
# AUTH_ENTRA_CLIENT_ASSERTION=
# A session ends after this many minutes without a request, and this many hours after sign-in.
AUTH_SESSION_IDLE_MINUTES=30
AUTH_SESSION_ABSOLUTE_HOURS=8
